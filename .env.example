# Z-Sheet 环境配置
# 复制本文件为 .env 后按需修改；.env 不会入库（docker compose 会自动读取它）。
# 所有变量均为可选项：不配置任何 LLM 变量时，系统以「纯规则引擎」兜底运行（仅覆盖典型台账表格，理解能力有限；正式使用建议配置模型）。

# ---- 方案 A：公有云（默认，试验期使用 DeepSeek）----
ZSHEET_LLM_BASE_URL=https://api.deepseek.com
ZSHEET_LLM_MODEL=deepseek-flash
ZSHEET_LLM_API_KEY=sk-your-key-here

# ---- 方案 B：本地引擎（Ollama / vLLM，OpenAI 兼容接口，无需 API Key）----
# Ollama 示例（先 ollama pull qwen2.5:7b）：
# ZSHEET_LLM_BASE_URL=http://host.docker.internal:11434/v1
# ZSHEET_LLM_MODEL=qwen2.5:7b
# ZSHEET_LLM_API_KEY=
# 注意：容器内访问宿主机的 Ollama 用 host.docker.internal；
#       本地 uvicorn 直跑时用 http://localhost:11434/v1。
# vLLM 示例：
# ZSHEET_LLM_BASE_URL=http://localhost:8001/v1
# ZSHEET_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# ZSHEET_LLM_API_KEY=

# 单次请求超时秒数（超时/5xx/429/坏输出会自动重试，理解层最终降级为规则引擎）
ZSHEET_LLM_TIMEOUT=60

# 首次调用失败后的额外重试次数（0 = 不重试，默认 1 = 最多 2 次调用）
ZSHEET_LLM_MAX_RETRIES=1

# DeepSeek 官方端点才会发送 thinking 字段；其他引擎忽略即可
ZSHEET_LLM_ENABLE_THINKING=true

# 日志级别：DEBUG / INFO / WARNING / ERROR
ZSHEET_LOG_LEVEL=INFO

# 数据目录（容器内已固定为 /app/data，本地运行默认 ./data）
# ZSHEET_DATA_DIR=./data

# 允许访问 API 的前端来源（JSON 数组或逗号分隔；默认本地 Vite 5173 端口）
# ZSHEET_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
