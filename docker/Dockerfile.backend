# Z-Sheet image — multi-stage build with uv (backend) and pnpm (frontend).
# Python is pinned to 3.12 and Node to 24 to match the frozen toolchain.
# The runtime stage is a single container: FastAPI serves the API and the
# built SPA (StaticFiles with client-side route fallback).

FROM node:24-slim AS frontend-builder

WORKDIR /app/frontend

RUN corepack enable && corepack prepare pnpm@12.9.1 --activate

# Install dependencies first for better layer caching.
COPY frontend/package.json frontend/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY frontend ./
RUN pnpm build

FROM python:3.12-slim AS builder

COPY --from=ghcr.io/astral-sh/uv:0.12.23 /uv /uvx /bin/

WORKDIR /app

# Install dependencies first for better layer caching.
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

# Install the backend package itself.
COPY README.md ./README.md
COPY backend ./backend
RUN uv sync --frozen --no-dev

# Migration tooling (alembic.ini is read from the working directory at runtime).
COPY alembic.ini ./alembic.ini
COPY migrations ./migrations

FROM python:3.12-slim AS runtime

RUN useradd --create-home --uid 1000 app \
    && mkdir -p /app/data \
    && chown app:app /app/data

WORKDIR /app
COPY --from=builder --chown=app:app /app /app
COPY --from=frontend-builder --chown=app:app /app/frontend/dist ./frontend_dist
COPY --chown=app:app examples ./examples

ENV PATH="/app/.venv/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    ZSHEET_DATA_DIR=/app/data

# Normalize line endings (Windows checkouts may carry CRLF), then make executable.
COPY docker/entrypoint.sh ./docker/entrypoint.sh
RUN sed -i 's/\r$//' ./docker/entrypoint.sh && chmod +x ./docker/entrypoint.sh

USER app
EXPOSE 8000

ENTRYPOINT ["./docker/entrypoint.sh"]
