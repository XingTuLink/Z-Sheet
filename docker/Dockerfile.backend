# Z-Sheet backend image — multi-stage build with uv.
# Python is pinned to 3.12 to match the frozen design-doc toolchain.
# Only classic Dockerfile syntax is used, so no external frontend image is needed.

FROM python:3.12-slim AS builder

COPY --from=ghcr.io/astral-sh/uv:0.12.23 /uv /uvx /bin/

WORKDIR /app

# Install dependencies first for better layer caching.
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

# Install the backend package itself.
COPY README.md ./README.md
COPY backend ./backend
RUN uv sync --frozen --no-dev

# Migration tooling (alembic.ini is read from the working directory at runtime).
COPY alembic.ini ./alembic.ini
COPY migrations ./migrations

FROM python:3.12-slim AS runtime

RUN useradd --create-home --uid 1000 app \
    && mkdir -p /app/data \
    && chown app:app /app/data

WORKDIR /app
COPY --from=builder --chown=app:app /app /app

ENV PATH="/app/.venv/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    ZSHEET_DATA_DIR=/app/data

# Normalize line endings (Windows checkouts may carry CRLF), then make executable.
COPY docker/entrypoint.sh ./docker/entrypoint.sh
RUN sed -i 's/\r$//' ./docker/entrypoint.sh && chmod +x ./docker/entrypoint.sh

USER app
EXPOSE 8000

ENTRYPOINT ["./docker/entrypoint.sh"]
